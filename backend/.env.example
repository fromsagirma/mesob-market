# Server Configuration
PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000

# Client Configuration
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173

# Database Connection (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/mesob_market

# Authentication & JWT
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_here
ACCESS_TOKEN_EXPIRES=15m

# Transactional Email (Gmail SMTP / Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cloud Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Chapa)
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key_here

# AI Shopping Assistant (Google Gemini)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Initial Admin Seed Credentials (for scripts/create_admin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=secureAdminPassword123
ADMIN_NAME=Administrator

# Finance Transaction Cleanup (minutes before pending marked failed, 0 to disable)
FINANCE_PENDING_FAIL_AFTER_MINUTES=0
